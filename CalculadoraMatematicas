package calculadoramatematica;

/**
 *
 * @author Ashley Camila Chalas Santana
 */
public class CalculadoraMatematica {

    /**
     * @param args the command line arguments
     */
    // Atributos privados para encapsular los datos de la calculadora
    private double numero1;
    private double numero2;

    /**
     * Constructor por defecto que inicializa los números en cero.
     */
    public CalculadoraMatematica() {
        this.numero1 = 0.0;
        this.numero2 = 0.0;
    }

    /**
     * Establece los valores para realizar los cálculos posteriores.
     * 
     * @param numero1 Primer operando numérico.
     * @param numero2 Segundo operando numérico.
     */
    public void establecerNumeros(double numero1, double numero2) {
        this.numero1 = numero1;
        this.numero2 = numero2;
    }

    /**
     * Calcula la suma de los dos números guardados.
     * 
     * @return Resultado de la adición (numero1 + numero2).
     */
    public double calcularSuma() {
        return numero1 + numero2;
    }

    /**
     * Calcula la resta entre los dos números guardados.
     * 
     * @return Resultado de la sustracción (numero1 - numero2).
     */
    public double calcularResta() {
        return numero1 - numero2;
    }

    /**
     * Calcula la multiplicación de los dos números guardados.
     * 
     * @return Resultado del producto (numero1 * numero2).
     */
    public double calcularMultiplicacion() {
        return numero1 * numero2;
    }

    /**
     * Realiza la división entre el primer número y el segundo.
     * Valida mediante un condicional que el divisor no sea cero para evitar errores de ejecución.
     * 
     * @return Resultado del cociente o Double.NaN si el divisor es cero.
     */
    public double calcularDivision() {
        // Manejo de la división por cero mediante condicional IF
        if (numero2 == 0) {
            System.out.println("Error: No se puede dividir entre cero.");
            return Double.NaN; // Retorna constante de valor indeterminado
        }
        return numero1 / numero2;
    }
}

